{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/js/*", "/data/*", "/*.js", "/*.css", "/*.png", "/*.jpg", "/*.ico", "/*.svg", "/*.xlsx", "/*.json"]
  },
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  },
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow, noarchive"
  }
}
